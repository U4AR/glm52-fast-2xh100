!.venv/lib/python3.12/site-packages/kt_kernel/kt_kernel_ext.cpython-312-x86_64-linux-gnu.so
# MTP/NEXTN-under-CUDA-graphs fixes (2026-06-30): kt verify-batch buffer
# registration + multi-step draft warmup hook. See BLOG / memory.
!.venv/lib/python3.12/site-packages/sglang/srt/model_executor/cuda_graph_runner.py
